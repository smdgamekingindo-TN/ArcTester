DATABASE_URL="postgresql://arctester:change-this-password@localhost:5432/arctester?schema=public"
PORT=4000
# Generate production secrets with: openssl rand -hex 32
JWT_SECRET=
# Cloudflare Turnstile private server-side verification key (required in production).
TURNSTILE_SECRET_KEY=
# Encrypts TOTP secrets; generate with openssl rand -hex 32 (64 hex chars).
TOTP_ENCRYPTION_KEY=

CORS_ORIGINS=
# Production Vercel frontend + Render API require cross-site cookie support.
# Production always emits SameSite=None; Secure. Local development uses Lax.
COOKIE_SAME_SITE=None
# Add the exact frontend origin, e.g. https://arctester.vercel.app
# CORS_ORIGINS=https://arctester.vercel.app

# Private Supabase Storage bucket for prepared lesson narration audio.
# Keep the bucket private. The service-role key is server-only and must never reach web/mobile builds.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=arctester-lesson-audio

# Google Identity Services (web Google sign-in) and Gmail API email delivery.
# GOOGLE_CLIENT_ID is the same OAuth Web client ID used as VITE_GOOGLE_CLIENT_ID in the web build.
# Add the production web origin to Authorized JavaScript origins in Google Cloud Console.
GOOGLE_CLIENT_ID=

# Gmail API email delivery using Google Cloud Console OAuth 2.0.
# Enable Gmail API and create an OAuth 2.0 Web application client in Google Cloud Console.
# Generate a refresh token with the https://www.googleapis.com/auth/gmail.send scope.
# Never put these values in Vercel frontend or mobile environment variables.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_NAME=ArcTester
# Public frontend URL used in password-reset and account emails.
APP_BASE_URL=https://arctester.vercel.app
