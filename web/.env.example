# Local Vite development proxy target (private; not exposed to browser code).
API_ORIGIN=http://localhost:4000

# Cloudflare Turnstile public site key (public, injected by vite.config.ts at build time).
TURNSTILE_SITE_KEY=

# Google Identity Services Web OAuth client ID; same value as api/GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
